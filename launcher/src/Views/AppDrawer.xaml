<UserControl x:Class="UmbraLauncher.Views.AppDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:UmbraLauncher.Core"
             xmlns:c="clr-namespace:UmbraLauncher.Controls"
             x:Name="DrawerRoot"
             Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolVis}}">
    <Grid>
        <Border Background="{StaticResource B.Backdrop}" core:Anim.ShowEffect="Fade" core:Behaviors.ClickCommand="{Binding CloseDrawerCommand}"/>

        <Border Width="470" HorizontalAlignment="Right" Background="#141418" BorderBrush="{StaticResource B.LineStrong}" BorderThickness="1,0,0,0"
                DataContext="{Binding DrawerApp}" core:Anim.ShowEffect="SlideLeft" AutomationProperties.AutomationId="Drawer">
            <Grid>
                <Border Height="320" VerticalAlignment="Top" Background="{Binding DrawerGlowBrush}" IsHitTestVisible="False"/>
                <ScrollViewer Style="{StaticResource Scroll.Slim}">
                    <StackPanel Margin="32,24,32,32">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="38" Height="38" core:Ui.Icon="{StaticResource I.Close}"
                                    Command="{Binding DataContext.CloseDrawerCommand, ElementName=DrawerRoot}" AutomationProperties.AutomationId="DrawerClose"/>
                            <WrapPanel VerticalAlignment="Center">
                                <Border Style="{StaticResource Badge.DarkRunning}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PulseDot Fill="{StaticResource B.Success}" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RunningLabel}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Badge.Dark}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisInv}}">
                                    <TextBlock Text="{Binding LastPlayedText}"/>
                                </Border>
                                <Border Style="{StaticResource Badge.Dark}" Visibility="{Binding RunAsAdmin, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{core:L Admin}"/>
                                </Border>
                                <Border Style="{StaticResource Badge.DarkDanger}" Visibility="{Binding IsMissing, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{core:L NotFound}"/>
                                </Border>
                            </WrapPanel>
                        </DockPanel>

                        <Grid HorizontalAlignment="Left" Margin="0,18,0,0">
                            <Image Source="{Binding Icon}" Width="88" Height="88" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect Color="{Binding GlowColor}" BlurRadius="50" ShadowDepth="0" Opacity="0.9"/>
                                </Image.Effect>
                            </Image>
                            <c:IconView Data="{StaticResource I.Layers}" Size="70" StrokeThickness="1.4" Foreground="#99FFFFFF"
                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolVisInv}}"/>
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontSize="32" Foreground="White"
                                   TextWrapping="Wrap" Margin="0,18,0,0"/>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource T.Mono}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,6,0,0"/>

                        <Grid Margin="0,24,0,0">
                            <Button Style="{StaticResource Btn.Primary}" Height="50" FontSize="14.5" core:Ui.Icon="{StaticResource I.Play}" Content="{core:L Launch}"
                                    Command="{Binding LaunchCommand}" AutomationProperties.AutomationId="DrawerLaunch"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolVisInv}}"/>
                            <Grid Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Btn.Light}" Height="50" core:Ui.Icon="{StaticResource I.Window}" Content="{core:L SwitchTo}"
                                        Command="{Binding FocusCommand}"/>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Danger}" Height="50" Margin="10,0,0,0" core:Ui.Icon="{StaticResource I.Stop}"
                                        Content="{core:L CloseApp}" Command="{Binding CloseAppCommand}"/>
                            </Grid>
                        </Grid>

                        <UniformGrid Columns="2" Margin="-6,20,-6,0">
                            <Border Style="{StaticResource Panel}" CornerRadius="12" Padding="16,14" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="{core:L StatTotal}" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource T.Value}" FontSize="20" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" CornerRadius="12" Padding="16,14" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="{core:L StatSessions}" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="{Binding SessionCountText}" Style="{StaticResource T.Value}" FontSize="20" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" CornerRadius="12" Padding="16,14" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="{core:L StatWeek}" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="{Binding WeekText}" Style="{StaticResource T.Value}" FontSize="20" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Panel}" CornerRadius="12" Padding="16,14" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="{core:L StatLongest}" Style="{StaticResource T.Label}"/>
                                    <TextBlock Text="{Binding LongestText}" Style="{StaticResource T.Value}" FontSize="20" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="{core:L DrawerActivity}" Style="{StaticResource T.H3}" Margin="0,24,0,12"/>
                        <Border Style="{StaticResource Panel}" CornerRadius="12" Padding="14,16,14,10">
                            <ItemsControl ItemsSource="{Binding Days}" Height="116" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent" ToolTip="{Binding Tooltip}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border x:Name="Bar" Height="{Binding Height}" VerticalAlignment="Bottom" Margin="3,0" CornerRadius="4,4,2,2"
                                                    Background="{DynamicResource B.AccentGradient}"/>
                                            <TextBlock x:Name="Lbl" Grid.Row="1" Text="{Binding Label}" Style="{StaticResource T.Small}" FontSize="10.5"
                                                       HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasValue}" Value="False">
                                                <Setter TargetName="Bar" Property="Background" Value="#16FFFFFF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource B.Text}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="{core:L DrawerSessions}" Style="{StaticResource T.H3}" Margin="0,24,0,6"/>
                        <TextBlock Text="{core:L DrawerNoSessions}" Style="{StaticResource T.Body}" FontSize="13.5" Margin="0,6,0,0"
                                   Visibility="{Binding HasSessions, Converter={StaticResource BoolVisInv}}"/>
                        <ItemsControl ItemsSource="{Binding RecentSessions}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="104"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding When}" Foreground="{StaticResource B.Text}" FontSize="13.5" VerticalAlignment="Center"/>
                                            <Border x:Name="Src" Grid.Column="1" Style="{StaticResource Badge.Dark}" Margin="0,0,12,0" Padding="7,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Source}" FontSize="10.5"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Duration}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource F.Semi}" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource B.Text}"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter TargetName="Src" Property="Style" Value="{StaticResource Badge.DarkRunning}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,24,0,0">
                            <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,10,10" core:Ui.Icon="{StaticResource I.Folder}" Content="{core:L Folder}"
                                    Command="{Binding OpenFolderCommand}"/>
                            <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,10,10" core:Ui.Icon="{StaticResource I.Edit}" Content="{core:L Edit}"
                                    Command="{Binding EditCommand}" AutomationProperties.AutomationId="DrawerEdit"/>
                            <Button Style="{StaticResource Btn.Danger}" Margin="0,0,10,10" core:Ui.Icon="{StaticResource I.Trash}" Content="{core:L Remove}"
                                    Command="{Binding RemoveCommand}" AutomationProperties.AutomationId="DrawerRemove"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
