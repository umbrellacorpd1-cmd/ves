<UserControl x:Class="UmbraLauncher.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:UmbraLauncher.Core"
             xmlns:c="clr-namespace:UmbraLauncher.Controls"
             WindowChrome.IsHitTestVisibleInChrome="True"
             Visibility="{Binding Confirm, Converter={StaticResource NullVis}}">
    <Grid>
        <Border Background="{StaticResource B.Backdrop}" core:Anim.ShowEffect="Fade" core:Behaviors.ClickCommand="{Binding Confirm.CancelCommand}"/>
        <Border DataContext="{Binding Confirm}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#141418" BorderBrush="{StaticResource B.LineStrong}" BorderThickness="1" CornerRadius="18" Padding="30,28,30,24"
                core:Anim.ShowEffect="Pop" AutomationProperties.AutomationId="ConfirmDialog">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="18" Direction="270" Opacity="0.6" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource B.DangerSoft}" HorizontalAlignment="Left">
                    <c:IconView Data="{StaticResource I.Alert}" Size="24" Foreground="{StaticResource B.DangerText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title}" Style="{StaticResource T.H2}" FontSize="19" Margin="0,18,0,0"/>
                <TextBlock Text="{Binding Message}" Style="{StaticResource T.Body}" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
                    <Button Style="{StaticResource Btn.Ghost}" Content="{core:L Cancel}" Command="{Binding CancelCommand}" IsCancel="True"
                            AutomationProperties.AutomationId="ConfirmCancel"/>
                    <Button Style="{StaticResource Btn.DangerSolid}" Margin="10,0,0,0" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                            AutomationProperties.AutomationId="ConfirmOk"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
