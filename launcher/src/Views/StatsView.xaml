<UserControl x:Class="UmbraLauncher.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:UmbraLauncher.Core"
             xmlns:c="clr-namespace:UmbraLauncher.Controls"
             x:Name="StatsRoot">
    <ScrollViewer Style="{StaticResource Scroll.Slim}">
        <StackPanel Margin="28,10,28,30" DataContext="{Binding Stats}">
            <TextBlock Text="{core:L StatsTitle}" Style="{StaticResource T.H1}"/>
            <TextBlock Text="{core:L StatsSubtitle}" Style="{StaticResource T.Body}" Margin="0,6,0,0"/>

            <!-- KPI tiles, tinted like Majestic's social tiles -->
            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,16,0">
                    <Border CornerRadius="14" Background="{StaticResource B.Surface}"/>
                    <Border CornerRadius="14" Background="{DynamicResource B.AccentSoft}" BorderBrush="{StaticResource B.Line}" BorderThickness="1"/>
                    <StackPanel Margin="22,20">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource I.Clock}" Size="16" Foreground="{DynamicResource B.AccentText}" VerticalAlignment="Center"/>
                            <TextBlock Text="{core:L KpiTotal}" Style="{StaticResource T.Label}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource T.Value}" FontSize="28" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding TotalSub}" Style="{StaticResource T.Small}" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" Margin="0,0,16,0">
                    <Border CornerRadius="14" Background="#151A2A" BorderBrush="{StaticResource B.Line}" BorderThickness="1"/>
                    <StackPanel Margin="22,20">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource I.Calendar}" Size="16" Foreground="#8EA8FF" VerticalAlignment="Center"/>
                            <TextBlock Text="{core:L KpiWeek}" Style="{StaticResource T.Label}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding WeekText}" Style="{StaticResource T.Value}" FontSize="28" Margin="0,14,0,0"/>
                        <TextBlock x:Name="WeekSub" Text="{Binding WeekSub}" Style="{StaticResource T.Small}" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="2" Margin="0,0,16,0">
                    <Border CornerRadius="14" Background="#13201A" BorderBrush="{StaticResource B.Line}" BorderThickness="1"/>
                    <StackPanel Margin="22,20">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource I.Bolt}" Size="16" Foreground="{StaticResource B.SuccessText}" VerticalAlignment="Center"/>
                            <TextBlock Text="{core:L KpiToday}" Style="{StaticResource T.Label}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayText}" Style="{StaticResource T.Value}" FontSize="28" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding TodaySub}" Style="{StaticResource T.Small}" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="3">
                    <Border CornerRadius="14" Background="{StaticResource B.Surface}"/>
                    <Border CornerRadius="14" Background="{Binding TopBrush}" BorderBrush="{StaticResource B.Line}" BorderThickness="1"/>
                    <Grid Margin="22,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource I.Trophy}" Size="16" Foreground="#F5C46B" VerticalAlignment="Center"/>
                                <TextBlock Text="{core:L KpiTop}" Style="{StaticResource T.Label}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TopName}" Style="{StaticResource T.Value}" FontSize="22" Margin="0,16,56,0"/>
                            <TextBlock Text="{Binding TopText}" Style="{StaticResource T.Small}" Margin="0,8,0,0" TextWrapping="NoWrap"/>
                        </StackPanel>
                        <Image Source="{Binding TopIcon}" Width="46" Height="46" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Activity chart -->
            <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="26,22,26,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding ChartTitle}" Style="{StaticResource T.H2}" FontSize="15" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource SegHost}" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegItem}" Content="{core:L Range7}"
                                             IsChecked="{Binding DataContext.StatsRange, ElementName=StatsRoot, Converter={StaticResource EqBool}, ConverterParameter=7}"/>
                                <RadioButton Style="{StaticResource SegItem}" Content="{core:L Range14}"
                                             IsChecked="{Binding DataContext.StatsRange, ElementName=StatsRoot, Converter={StaticResource EqBool}, ConverterParameter=14}"/>
                                <RadioButton Style="{StaticResource SegItem}" Content="{core:L Range30}"
                                             IsChecked="{Binding DataContext.StatsRange, ElementName=StatsRoot, Converter={StaticResource EqBool}, ConverterParameter=30}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="190"/>
                            <RowDefinition Height="48"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding AxisTop}" Style="{StaticResource T.Small}" FontSize="11.5" VerticalAlignment="Top" Margin="0,-8,0,0"/>
                        <TextBlock Text="{Binding AxisMid}" Style="{StaticResource T.Small}" FontSize="11.5" VerticalAlignment="Center"/>
                        <TextBlock Text="0" Style="{StaticResource T.Small}" FontSize="11.5" VerticalAlignment="Bottom" Margin="0,0,0,-8"/>

                        <Grid Grid.Column="1">
                            <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
                            <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" VerticalAlignment="Center"/>
                            <Border BorderBrush="{StaticResource B.LineStrong}" BorderThickness="0,1,0,0" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{core:L ChartEmpty}" Style="{StaticResource T.Small}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,0,0,40" Visibility="{Binding HasChartData, Converter={StaticResource BoolVisInv}}"/>
                        </Grid>

                        <ItemsControl Grid.Column="1" Grid.RowSpan="2" ItemsSource="{Binding Bars}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip="{Binding Tooltip}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="190"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border x:Name="Bar" Height="{Binding Height}" MaxWidth="34" Margin="4,0" VerticalAlignment="Bottom" CornerRadius="6,6,2,2"
                                                Background="{DynamicResource B.AccentGradient}" Opacity="0.78"/>
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,0"
                                                    Visibility="{Binding ShowLabel, Converter={StaticResource BoolVis}}">
                                            <TextBlock x:Name="Lbl" Text="{Binding Label}" Style="{StaticResource T.Small}" FontSize="11.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding SubLabel}" Style="{StaticResource T.Small}" FontSize="10.5" HorizontalAlignment="Center" Opacity="0.7"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasValue}" Value="False">
                                            <Setter TargetName="Bar" Property="Background" Value="#14FFFFFF"/>
                                            <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                                            <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource B.Text}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Ranking -->
            <Border Style="{StaticResource Panel}" Margin="0,18,0,0" Padding="26,22,26,14">
                <StackPanel>
                    <TextBlock Text="{core:L RankTitle}" Style="{StaticResource T.H2}" FontSize="15"/>
                    <TextBlock Text="{core:L RankEmpty}" Style="{StaticResource T.Body}" Margin="0,14,0,8"
                               Visibility="{Binding HasData, Converter={StaticResource BoolVisInv}}"/>
                    <ItemsControl ItemsSource="{Binding Ranking}" Margin="0,12,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="0,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="280"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank, StringFormat={}{0:00}}" FontFamily="{StaticResource F.Mono}" FontWeight="SemiBold"
                                                   FontSize="13" Foreground="{StaticResource B.Dim}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="11" Background="{Binding App.SoftBrush}" HorizontalAlignment="Left">
                                            <Image Source="{Binding App.Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,20,0">
                                            <TextBlock Text="{Binding App.Name}" Style="{StaticResource T.Strong}" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SubText}" Style="{StaticResource T.Small}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Grid Grid.Column="3" Height="8" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Background="#12FFFFFF"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BarWidth}"/>
                                                    <ColumnDefinition Width="{Binding RestWidth}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="4" Background="{Binding App.ColorBrush}"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Grid.Column="4" Text="{Binding TimeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource F.Display}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource B.Text}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
