<UserControl x:Class="UmbraLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:UmbraLauncher.Core"
             xmlns:c="clr-namespace:UmbraLauncher.Controls">
    <ScrollViewer Style="{StaticResource Scroll.Slim}">
        <StackPanel Margin="28,10,28,30">
            <TextBlock Text="{core:L SettingsTitle}" Style="{StaticResource T.H1}"/>
            <TextBlock Text="{core:L SettingsSubtitle}" Style="{StaticResource T.Body}" Margin="0,6,0,0"/>

            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <!-- Appearance -->
                    <Border Style="{StaticResource Panel}" Padding="26,22">
                        <StackPanel>
                            <TextBlock Text="{core:L SecAppearance}" Style="{StaticResource T.H2}" FontSize="14"/>

                            <Grid Margin="0,20,0,0">
                                <TextBlock Text="{core:L Language}" Style="{StaticResource T.Strong}" FontSize="14" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource SegHost}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegItem}" Content="Русский" AutomationProperties.AutomationId="LangRu"
                                                     IsChecked="{Binding Language, Converter={StaticResource EqBool}, ConverterParameter=ru}"/>
                                        <RadioButton Style="{StaticResource SegItem}" Content="English" AutomationProperties.AutomationId="LangEn"
                                                     IsChecked="{Binding Language, Converter={StaticResource EqBool}, ConverterParameter=en}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,20,0,0">
                                <TextBlock Text="{core:L Accent}" Style="{StaticResource T.Strong}" FontSize="14" VerticalAlignment="Center"/>
                                <ItemsControl ItemsSource="{Binding AccentOptions}" HorizontalAlignment="Right" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding SelectCommand}" Cursor="Hand" Margin="4,0,0,0" ToolTip="{Binding Hex}" FocusVisualStyle="{x:Null}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Width="32" Height="32" Background="Transparent">
                                                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="2" Opacity="0"/>
                                                            <Ellipse Fill="{Binding Brush}" Margin="5"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Ring" Property="Opacity" Value="0.45"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <TextBlock Text="{core:L LauncherTitle}" Style="{StaticResource T.Strong}" FontSize="14" Margin="0,22,0,0"/>
                            <TextBlock Text="{core:L LauncherTitleHint}" Style="{StaticResource T.Small}" Margin="0,3,0,10"/>
                            <TextBox Style="{StaticResource Input}" Text="{Binding LauncherTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="24"
                                     core:Ui.Placeholder="Umbra" AutomationProperties.AutomationId="TitleBox"/>
                        </StackPanel>
                    </Border>

                    <!-- Behavior -->
                    <Border Style="{StaticResource Panel}" Padding="26,22" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="{core:L SecBehavior}" Style="{StaticResource T.H2}" FontSize="14"/>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding MinimizeOnLaunch}" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="{core:L MinimizeOnLaunch}" Style="{StaticResource T.Strong}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="{core:L MinimizeOnLaunchHint}" Style="{StaticResource T.Small}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CloseToTray}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="{core:L CloseToTray}" Style="{StaticResource T.Strong}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="{core:L CloseToTrayHint}" Style="{StaticResource T.Small}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="{core:L StartWithWindows}" Style="{StaticResource T.Strong}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="{core:L StartWithWindowsHint}" Style="{StaticResource T.Small}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- Tracking -->
                    <Border Style="{StaticResource Panel}" Padding="26,22">
                        <StackPanel>
                            <TextBlock Text="{core:L SecTracking}" Style="{StaticResource T.H2}" FontSize="14"/>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding TrackExternal}" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="{core:L TrackExternal}" Style="{StaticResource T.Strong}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="{core:L TrackExternalHint}" Style="{StaticResource T.Small}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding FocusOnly}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="{core:L FocusOnly}" Style="{StaticResource T.Strong}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="{core:L FocusOnlyHint}" Style="{StaticResource T.Small}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- Data -->
                    <Border Style="{StaticResource Panel}" Padding="26,22" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="{core:L SecData}" Style="{StaticResource T.H2}" FontSize="14"/>
                            <TextBlock Text="{core:L DataFolder}" Style="{StaticResource T.Strong}" FontSize="14" Margin="0,20,0,8"/>
                            <Border Background="{StaticResource B.Field}" BorderBrush="{StaticResource B.Line}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <TextBlock Text="{Binding DataDir}" Style="{StaticResource T.Mono}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataDir}"/>
                            </Border>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,10,10" core:Ui.Icon="{StaticResource I.Folder}" Content="{core:L OpenDataFolder}"
                                        Command="{Binding OpenDataFolderCommand}"/>
                                <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,10,10" core:Ui.Icon="{StaticResource I.Download}" Content="{core:L ExportCsv}"
                                        Command="{Binding ExportCsvCommand}"/>
                                <Button Style="{StaticResource Btn.Danger}" Margin="0,0,10,10" core:Ui.Icon="{StaticResource I.Trash}" Content="{core:L ResetStats}"
                                        Command="{Binding ResetStatsCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- About -->
                    <Border Style="{StaticResource Panel}" Padding="26,22" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="{core:L SecAbout}" Style="{StaticResource T.H2}" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource B.AccentGradient}">
                                    <c:IconView Data="{StaticResource I.Play}" IsFilled="True" Size="21" Foreground="White" Margin="2,0,0,0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding WindowTitle}" FontFamily="{StaticResource F.Brand}" FontWeight="Black" FontStyle="Italic" FontSize="18" Foreground="White"/>
                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource T.Mono}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{core:L AboutText}" Style="{StaticResource T.Body}" FontSize="13.5" Margin="0,16,0,0"/>
                            <TextBlock Text="{core:L Hotkeys}" Style="{StaticResource T.Mono}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
